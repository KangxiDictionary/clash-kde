[Unit]
Description=Clash KDE mihomo session service
After=graphical-session.target dbus.service

[Service]
Type=dbus
BusName=org.kde.clashkde
ExecStart=/usr/bin/clash-kde
# If the service crashes or is stopped, never leave the desktop proxy pointing
# at a dead port. This also runs when systemd restarts the service.
ExecStopPost=-/usr/bin/clash-kde --restore-proxy
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
