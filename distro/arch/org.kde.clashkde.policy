<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN" "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>clash-kde</vendor>
  <vendor_url>https://github.com/KangxiDictionary/clash-kde</vendor_url>

  <action id="org.kde.clashkde.tun">
    <description>Capture this account's traffic with Mihomo</description>
    <description xml:lang="zh-Hans-CN">用 Mihomo 截取这个账户的流量</description>
    <description xml:lang="zh-Hant-TW">用 Mihomo 截取這個帳戶的流量</description>
    <description xml:lang="ja">Mihomo でこのアカウントの通信を取り込む</description>
    <description xml:lang="ko">Mihomo로 이 계정의 트래픽을 잡기</description>
    <description xml:lang="de">Den Verkehr dieses Kontos mit Mihomo erfassen</description>
    <description xml:lang="fr">Capturer le trafic de ce compte avec Mihomo</description>
    <description xml:lang="es">Capturar el tráfico de esta cuenta con Mihomo</description>
    <description xml:lang="pt-BR">Capturar o tráfego desta conta com o Mihomo</description>
    <description xml:lang="ru">Перехватывать трафик этой учётной записи через Mihomo</description>
    <description xml:lang="it">Catturare il traffico di questo account con Mihomo</description>
    <message>Authentication is required to capture this account's network traffic.</message>
    <message xml:lang="zh-Hans-CN">需要认证才能截取这个账户的网络流量。</message>
    <message xml:lang="zh-Hant-TW">需要認證才能截取這個帳戶的網路流量。</message>
    <message xml:lang="ja">このアカウントの通信を取り込むには認証が必要です。</message>
    <message xml:lang="ko">이 계정의 네트워크 트래픽을 잡으려면 인증이 필요합니다.</message>
    <message xml:lang="de">Zum Erfassen des Netzwerkverkehrs dieses Kontos ist eine Authentifizierung nötig.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour capturer le trafic réseau de ce compte.</message>
    <message xml:lang="es">Hace falta autenticarse para capturar el tráfico de red de esta cuenta.</message>
    <message xml:lang="pt-BR">É preciso autenticar para capturar o tráfego de rede desta conta.</message>
    <message xml:lang="ru">Чтобы перехватывать сетевой трафик этой учётной записи, нужна аутентификация.</message>
    <message xml:lang="it">Serve un'autenticazione per catturare il traffico di rete di questo account.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>

  <action id="org.kde.clashkde.tun-machine">
    <description>Send every account and root through this account</description>
    <description xml:lang="zh-Hans-CN">让所有账户和 root 走这个账户</description>
    <description xml:lang="zh-Hant-TW">讓所有帳戶和 root 走這個帳戶</description>
    <description xml:lang="ja">すべてのアカウントと root をこのアカウントに通す</description>
    <description xml:lang="ko">모든 계정과 root를 이 계정으로 보내기</description>
    <description xml:lang="de">Alle Konten und root durch dieses Konto leiten</description>
    <description xml:lang="fr">Envoyer tous les comptes et root par ce compte</description>
    <description xml:lang="es">Enviar todas las cuentas y root por esta cuenta</description>
    <description xml:lang="pt-BR">Enviar todas as contas e o root por esta conta</description>
    <description xml:lang="ru">Направить все учётные записи и root через эту учётную запись</description>
    <description xml:lang="it">Instradare tutti gli account e root attraverso questo account</description>
    <message>Authentication is required to send every account and root through this account.</message>
    <message xml:lang="zh-Hans-CN">需要管理员认证才能让所有账户和 root 走这个账户。</message>
    <message xml:lang="zh-Hant-TW">需要管理員認證才能讓所有帳戶和 root 走這個帳戶。</message>
    <message xml:lang="ja">すべてのアカウントと root をこのアカウントに通すには管理者の認証が必要です。</message>
    <message xml:lang="ko">모든 계정과 root를 이 계정으로 보내려면 관리자 인증이 필요합니다.</message>
    <message xml:lang="de">Zum Leiten aller Konten und von root durch dieses Konto ist eine Administrator-Authentifizierung nötig.</message>
    <message xml:lang="fr">Une authentification d'administrateur est nécessaire pour envoyer tous les comptes et root par ce compte.</message>
    <message xml:lang="es">Hace falta autenticarse como administrador para enviar todas las cuentas y root por esta cuenta.</message>
    <message xml:lang="pt-BR">É preciso autenticar como administrador para enviar todas as contas e o root por esta conta.</message>
    <message xml:lang="ru">Чтобы направить все учётные записи и root через эту учётную запись, нужна аутентификация администратора.</message>
    <message xml:lang="it">Serve un'autenticazione da amministratore per instradare tutti gli account e root attraverso questo account.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.kde.clashkde.manage-users">
    <description>View or change Mihomo for a signed-in account</description>
    <description xml:lang="zh-Hans-CN">查看或开关已登录账户的 Mihomo</description>
    <description xml:lang="zh-Hant-TW">開關已登入帳戶的 Mihomo</description>
    <description xml:lang="ja">ログイン中のアカウントの Mihomo を起動または停止する</description>
    <description xml:lang="ko">로그인한 계정의 Mihomo를 켜거나 끄기</description>
    <description xml:lang="de">Mihomo eines angemeldeten Kontos starten oder stoppen</description>
    <description xml:lang="fr">Démarrer ou arrêter Mihomo pour un compte connecté</description>
    <description xml:lang="es">Arrancar o detener Mihomo de una cuenta con sesión iniciada</description>
    <description xml:lang="pt-BR">Iniciar ou parar o Mihomo de uma conta conectada</description>
    <description xml:lang="ru">Запускать или останавливать Mihomo вошедшей учётной записи</description>
    <description xml:lang="it">Avviare o fermare Mihomo per un account che ha effettuato l'accesso</description>
    <message>Authentication is required to view or change Mihomo for a signed-in account.</message>
    <message xml:lang="zh-Hans-CN">需要认证才能$(reason)。</message>
    <message xml:lang="zh-Hant-TW">需要認證才能查看或開關已登入帳戶的 Mihomo。</message>
    <message xml:lang="ja">ログイン中のアカウントの Mihomo を表示または変更するには認証が必要です。</message>
    <message xml:lang="ko">로그인한 계정의 Mihomo를 보거나 바꾸려면 인증이 필요합니다.</message>
    <message xml:lang="de">Zum Anzeigen oder Ändern von Mihomo für ein angemeldetes Konto ist eine Authentifizierung nötig.</message>
    <message xml:lang="fr">Une authentification est nécessaire pour afficher ou modifier Mihomo pour un compte connecté.</message>
    <message xml:lang="es">Hace falta autenticarse para ver o cambiar Mihomo de una cuenta con sesión iniciada.</message>
    <message xml:lang="pt-BR">É preciso autenticar para ver ou alterar o Mihomo de uma conta conectada.</message>
    <message xml:lang="ru">Чтобы просматривать или менять Mihomo у вошедшей учётной записи, нужна аутентификация.</message>
    <message xml:lang="it">Serve un'autenticazione per vedere o modificare Mihomo per un account che ha effettuato l'accesso.</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
