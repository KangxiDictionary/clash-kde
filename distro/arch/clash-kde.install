_foreach_user() {
    local dir uid user
    shopt -s nullglob
    for dir in /run/user/*; do
        uid=${dir##*/}
        [[ "$uid" =~ ^[0-9]+$ ]] || continue
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [[ -S "$dir/bus" ]] || continue
        XDG_RUNTIME_DIR="$dir" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=${dir}/bus" \
            runuser -u "$user" -- "$@" || true
    done
}

post_install() {
    systemctl --global enable clash-kde.service || true
    systemctl daemon-reload || true
    _foreach_user systemctl --user daemon-reload
    _foreach_user systemctl --user start clash-kde.service
}

post_upgrade() {
    systemctl --global enable clash-kde.service || true
    systemctl daemon-reload || true
    _foreach_user systemctl --user daemon-reload
    _foreach_user systemctl --user try-restart clash-kde.service
}

pre_remove() {
    systemctl stop clash-kde-system.service || true
    _foreach_user systemctl --user disable --now clash-kde.service
    systemctl --global disable clash-kde.service || true
    if [[ -x /usr/bin/clash-kde ]]; then
        _foreach_user /usr/bin/clash-kde --restore-proxy
    fi
}
