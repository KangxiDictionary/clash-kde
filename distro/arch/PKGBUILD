# Maintainer: clash-kde contributors
pkgname=clash-kde
pkgver=1.0.3
pkgrel=22
pkgdesc='KDE System Settings module and panel widget for a per-user mihomo proxy'
arch=('x86_64' 'aarch64')
url='https://github.com/KangxiDictionary/clash-kde'
license=('GPL-3.0-or-later')
depends=(
    'mihomo'
    'qt6-base'
    'qt6-declarative'
    'kcmutils'
    'kirigami'
    'kirigami-addons'
    'kquickcharts'
    'ki18n'
    'kconfig'
    'kcoreaddons'
    'libplasma'
    'plasma-workspace'
    'dbus'
    'polkit'
)
makedepends=(
    'cargo'
    'cmake'
    'extra-cmake-modules'
    'qt6-tools'
    'kcmutils'
    'libplasma'
)
install=clash-kde.install
optdepends=('v2ray: supplies geoip.dat/geosite.dat when no MMDB is available')
options=('!lto')

build() {
    cd "${startdir}/../.."
    export CARGO_TARGET_DIR="${srcdir}/target"
    cargo build --release --locked
    cmake -B "${srcdir}/kcm-build" -S "${startdir}/../../kcm" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "${srcdir}/kcm-build"
}

package() {
    cd "${startdir}/../.."
    install -Dm755 "${srcdir}/target/release/clash-kde" "${pkgdir}/usr/bin/clash-kde"
    DESTDIR="${pkgdir}" cmake --install "${srcdir}/kcm-build"
    install -Dm644 distro/arch/clash-kde.service \
        "${pkgdir}/usr/lib/systemd/user/clash-kde.service"
    install -Dm644 distro/arch/org.kde.clashkde.service \
        "${pkgdir}/usr/share/dbus-1/services/org.kde.clashkde.service"
    install -Dm644 distro/arch/90-clash-kde.preset \
        "${pkgdir}/usr/lib/systemd/user-preset/90-clash-kde.preset"
    install -Dm644 distro/arch/clash-kde-system.service \
        "${pkgdir}/usr/lib/systemd/system/clash-kde-system.service"
    install -Dm644 distro/arch/org.kde.clashkde.Admin.service \
        "${pkgdir}/usr/share/dbus-1/system-services/org.kde.clashkde.Admin.service"
    install -Dm644 distro/arch/org.kde.clashkde.Admin.conf \
        "${pkgdir}/usr/share/dbus-1/system.d/org.kde.clashkde.Admin.conf"
    install -Dm644 distro/arch/org.kde.clashkde.policy \
        "${pkgdir}/usr/share/polkit-1/actions/org.kde.clashkde.policy"
}
