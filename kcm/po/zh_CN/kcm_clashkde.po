msgstr "每次测速经代理和直接连接各下载多少，范围为 1 到 100 MB。"

msgid "Username and password are both required, and neither may contain a colon."
msgstr "用户名和密码必须同时填写，且都不能包含冒号。"

msgid "The username cannot contain a colon."
msgstr "用户名不能包含冒号。"

msgid "The password cannot contain a colon."
msgstr "密码不能包含冒号。"

msgid "Fill in both the username and the password, or leave both empty."
msgstr "请同时填写用户名和密码，或两者都留空。"

msgid "Allowed range: 1 to 65535. HTTP and SOCKS share this port."
msgstr "允许范围：1 到 65535。HTTP 和 SOCKS 共用这个端口。"

msgid "Allowed range: 1 to 65535, and it must differ from the mixed port."
msgstr "允许范围：1 到 65535，且必须与混合端口不同。"

msgid "The controller port must differ from the mixed port."
msgstr "控制器端口必须与混合端口不同。"

