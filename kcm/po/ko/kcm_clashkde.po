msgstr "아직 업데이트하지 않음"

msgid "Optional"
msgstr "선택"

msgid "Override file"
msgstr "덮어쓰기 파일"

msgid "Point KDE applications at this core while it is running"
msgstr "코어가 실행 중일 때 KDE 프로그램을 그쪽으로 보냅니다"

msgid "Nodes"
msgstr "노드"

msgid "Remove"
msgstr "제거"

msgid "Remove this subscription?"
msgstr "이 구독을 제거할까요?"

msgid "Restart core"
msgstr "코어 다시 시작"

