msgid "There is a Mihomo widget for the panel."
msgstr "패널용 Mihomo 위젯이 있습니다."

msgid "Other programs can use this address as it is."
msgstr "다른 프로그램도 이 주소를 그대로 쓸 수 있습니다."

msgid "This switch only starts the local proxy."
msgstr "이 스위치는 로컬 프록시만 켭니다."

msgid "This takes effect only while the core is running and TUN is off."
msgstr "코어가 실행 중이고 TUN이 꺼져 있을 때만 적용됩니다."

msgid "Restart the core with the configuration it already has."
msgstr "지금 설정 그대로 코어를 다시 시작합니다."

msgid "See which region the traffic is leaving from."
msgstr "트래픽이 지금 어느 지역으로 나가는지 봅니다."

msgid "HTTP and SOCKS share this port, and saving restarts a running core."
msgstr "HTTP와 SOCKS가 이 포트를 같이 쓰며, 저장하면 켜진 코어가 다시 시작됩니다."

msgid "This page talks to the controller, which listens only on this computer."
msgstr "이 페이지는 컨트롤러와 이야기하며, 컨트롤러는 이 컴퓨터에서만 듣습니다."

msgid "This is the mihomo program already installed on the system."
msgstr "시스템에 이미 설치되어 있는 mihomo입니다."

msgid "This file is placed over the subscription, while the listen address stays set here."
msgstr "이 파일이 구독 위에 덮이며, 수신 주소는 여전히 여기서 정합니다."

msgid "A subscription update replaces the text written here."
msgstr "구독을 업데이트하면 여기에 쓴 내용이 바뀝니다."

msgid "TUN"
msgstr "TUN"

msgid "This captures only this account's traffic, and the system proxy steps aside while it is on."
msgstr "이 계정의 트래픽만 잡고, 켜져 있는 동안에는 시스템 프록시가 비켜 줍니다."

msgid "Users"
msgstr "사용자"

msgid "This page starts and stops Mihomo for accounts that are signed in."
msgstr "이 페이지는 로그인한 계정 자신의 Mihomo를 켜고 끕니다."

msgid "Account"
msgstr "계정"

msgid "On"
msgstr "켜짐"

msgid "Off"
msgstr "꺼짐"

msgid "Start"
msgstr "시작"

msgid "Stop"
msgstr "중지"

msgid "Check"
msgstr "검사"

msgid "Open in editor"
msgstr "편집기로 열기"

msgid "This configuration can be read."
msgstr "이 구성을 읽을 수 있습니다."

msgid "No text editor was found."
msgstr "텍스트 편집기를 찾지 못했습니다."

msgid "View log"
msgstr "로그 보기"

msgid "Core log"
msgstr "코어 로그"

msgid "There is no log yet."
msgstr "아직 로그가 없습니다."

msgid "Start this account's core"
msgstr "이 계정의 코어 시작"

msgid "Stop this account's core"
msgstr "이 계정의 코어 중지"

msgid "The core is running."
msgstr "코어가 실행 중입니다."

msgid "The core is stopped."
msgstr "코어가 중지되어 있습니다."

msgid "Traffic capture"
msgstr "트래픽 가로채기"

msgid "This account"
msgstr "이 계정"

msgid "No signed-in accounts."
msgstr "로그인한 계정이 없습니다."

msgid "This page starts or stops the core of a signed-in account."
msgstr "이 페이지에서는 로그인한 계정의 코어를 시작하거나 중지합니다."

msgid "The firewall is on, and it can drop TUN traffic."
msgstr "방화벽이 켜져 있어 TUN 트래픽이 버려질 수 있습니다."

msgid "Profiles"
msgstr "프로필"

msgid "No profiles yet"
msgstr "아직 프로필이 없습니다"

msgid "Remove this profile?"
msgstr "이 프로필을 제거할까요?"

msgid "Test delay automatically"
msgstr "지연을 자동으로 측정"

msgid "Use the same sort for every group"
msgstr "모든 그룹에 같은 정렬 사용"

msgid "Tests the delay of the group you are looking at."
msgstr "보고 있는 그룹의 지연을 자동으로 측정합니다."

msgid "Blur the IP"
msgstr "IP 흐리게"

msgid "Hides the latter half of the exit address; right-click copies the full address, and three quick clicks show it."
msgstr "출구 주소의 뒷부분을 숨기며, 오른쪽 클릭으로 전체 주소를 복사하고 세 번 누르면 표시합니다."

msgid "TUN device"
msgstr "TUN 장치"

msgid "Leave this empty to let the kernel choose the name, and applying a new name asks you to confirm."
msgstr "비워 두면 커널이 이름을 정하고, 새 이름을 적용하면 확인을 요청합니다."

msgid "Open file"
msgstr "파일 열기"

msgid "Opens the override file, creating it from the template when it is missing."
msgstr "덮어쓰기 파일을 열고, 없으면 서식으로 만듭니다."

msgid "Open folder"
msgstr "폴더 열기"

msgid "Opens the folder that contains the override file."
msgstr "덮어쓰기 파일이 있는 폴더를 엽니다."

msgid "Keeps one sort and filter for every group and profile."
msgstr "정렬과 필터를 하나로 기억해서 모든 그룹과 프로필에 씁니다."

msgid "%1 B/s"
msgstr "%1 B/초"

msgid "%1 KB/s"
msgstr "%1 KB/초"

msgid "%1 MB/s"
msgstr "%1 MB/초"

msgid "%1 ms"
msgstr "%1밀리초"

msgid "Active"
msgstr "사용 중"

msgid "Add subscription"
msgstr "구독 추가"

msgid "Advanced"
msgstr "고급"

msgid "Check region"
msgstr "지역 확인"

msgid "Controller port"
msgstr "컨트롤러 포트"

msgid "Core"
msgstr "코어"

msgid "Core is not running"
msgstr "코어가 실행 중이 아닙니다"

msgid "Core state"
msgstr "코어 상태"

msgid "Direct"
msgstr "직접"

msgid "Download"
msgstr "다운로드"

msgid "Exit region"
msgstr "출구 지역"

msgid "Global"
msgstr "전역"

msgid "Group"
msgstr "그룹"

msgid "KDE proxy is pointing at this core"
msgstr "KDE 프록시가 이 코어를 가리킵니다"

msgid "KDE proxy is unchanged"
msgstr "KDE 프록시는 그대로입니다"

msgid "Last update: %1"
msgstr "마지막 업데이트: %1"

msgid "Listen address"
msgstr "수신 주소"

msgid "Mixed port"
msgstr "혼합 포트"

msgid "Mode"
msgstr "모드"

msgid "Name"
msgstr "이름"

msgid "No proxy groups"
msgstr "그룹이 없습니다"

msgid "No subscriptions yet"
msgstr "아직 구독이 없습니다"

msgid "Not checked yet"
msgstr "아직 확인하지 않음"

msgid "Not tested"
msgstr "측정 안 함"

msgid "Not updated yet"
msgstr "아직 업데이트하지 않음"

msgid "Optional"
msgstr "선택"

msgid "Override file"
msgstr "덮어쓰기 파일"

msgid "Point KDE applications at this core while it is running"
msgstr "코어가 실행 중일 때 KDE 프로그램을 그쪽으로 보냅니다"

msgid "Proxies"
msgstr "프록시"

msgid "Remove"
msgstr "제거"

msgid "Remove this subscription?"
msgstr "이 구독을 제거할까요?"

msgid "Restart core"
msgstr "코어 다시 시작"

msgid "Rule"
msgstr "규칙"

msgid "Run mihomo without changing the KDE proxy"
msgstr "KDE 프록시를 바꾸지 않고 mihomo 실행"

msgid "Running"
msgstr "실행 중"

msgid "Status"
msgstr "상태"

msgid "Stopped"
msgstr "중지됨"

msgid "System proxy"
msgstr "시스템 프록시"

msgid "Test delays"
msgstr "지연 테스트"

msgid "The controller listens only on this computer. TUN stays off in this version. Applying restarts the core when it is running."
msgstr "컨트롤러는 이 컴퓨터에서만 수신합니다. 이 버전에서는 TUN이 꺼져 있습니다. 적용하면 실행 중인 코어가 다시 시작됩니다."

msgid "The system proxy choice is saved. It is applied while the core is running."
msgstr "시스템 프록시 선택은 저장되며, 코어가 실행 중일 때만 적용됩니다."

msgid "Timeout"
msgstr "시간 초과"

msgid "URL"
msgstr "URL"

msgid "Update"
msgstr "업데이트"

msgid "Upload"
msgstr "업로드"

msgid "Use"
msgstr "사용"

msgid "Waiting to start"
msgstr "시작 대기"

msgid "mihomo executable"
msgstr "mihomo 실행 파일"

msgid "Applied"
msgstr "적용됨"

msgid "Not applied"
msgstr "적용 안 됨"

msgid "Restart"
msgstr "다시 시작"

msgid "Traffic"
msgstr "트래픽"

msgid "Subscriptions"
msgstr "구독"

msgid "Connection"
msgstr "연결"

msgid "While the core is running, KDE applications use it. Turning the core off withdraws it."
msgstr "코어가 실행 중이면 KDE 프로그램이 그것을 사용합니다. 코어를 끄면 그 설정은 거두어집니다."

msgid "Profile order"
msgstr "프로필 순서"

msgid "Delay"
msgstr "지연"

msgid "Show unreachable"
msgstr "도달할 수 없는 항목 표시"

msgid "Sort and filter"
msgstr "정렬과 필터"

msgid "Import"
msgstr "가져오기"

msgid "Import configuration"
msgstr "구성 가져오기"

msgid "Edit details"
msgstr "정보 편집"

msgid "Edit configuration"
msgstr "구성 편집"

msgid "Remaining: %1"
msgstr "남음: %1"

msgid "Expires: %1"
msgstr "만료: %1"

msgid "%1 B"
msgstr "%1 B"

msgid "%1 KB"
msgstr "%1 KB"

msgid "%1 MB"
msgstr "%1 MB"

msgid "%1 GB"
msgstr "%1 GB"

msgid "More actions"
msgstr "다른 동작"

msgid "About"
msgstr "정보"

msgid "Version"
msgstr "버전"

msgid "License"
msgstr "라이선스"

msgid "Website"
msgstr "웹사이트"

msgid "Mihomo"
msgstr "Mihomo"

msgid "Pointing at this core."
msgstr "이 코어를 가리키고 있습니다."

msgid "Pointing somewhere else."
msgstr "다른 곳을 가리키고 있습니다."

msgid "Not set."
msgstr "설정되지 않았습니다."

msgid "KDE proxy"
msgstr "KDE 프록시"

msgid "GNOME proxy"
msgstr "GNOME 프록시"

msgid "Shows whether KDE is telling programs to use a proxy."
msgstr "KDE가 프로그램에 프록시를 쓰라고 알려 주는지 표시합니다."

msgid "Shows whether GNOME is telling programs to use a proxy."
msgstr "GNOME이 프로그램에 프록시를 쓰라고 알려 주는지 표시합니다."

msgid "This computer"
msgstr "이 컴퓨터"

msgid "Accounts"
msgstr "계정"

msgid "Manage signed-in accounts"
msgstr "로그인한 계정 관리"

msgid "Asks for the administrator password, then lists the other signed-in accounts."
msgstr "관리자 암호를 확인한 다음 다른 로그인 계정을 보여 줍니다."

msgid "Lock"
msgstr "잠금"

msgid "Capture the whole computer"
msgstr "컴퓨터 전체 캡처"

msgid "Sends every account and root through this account's configuration."
msgstr "모든 계정과 root를 이 계정의 설정으로 보냅니다."

msgid "Signed-in accounts"
msgstr "로그인한 계정"

msgid "No other signed-in accounts."
msgstr "다른 로그인 계정이 없습니다."

msgid "Back"
msgstr "뒤로"

msgid "Exit"
msgstr "출구"

msgid "Other"
msgstr "기타"

msgid "No matches"
msgstr "일치하는 항목 없음"

msgid "Copy"
msgstr "복사"

msgid "Copied the address."
msgstr "주소를 복사했습니다."

msgid "Allow LAN"
msgstr "로컬 네트워크 허용"

msgid "The administrator turned this off."
msgstr "관리자가 이 기능을 껐습니다."

msgid "Lets other computers on the local network use the mixed port. The controller stays on this computer."
msgstr "같은 네트워크의 다른 컴퓨터가 혼합 포트를 사용할 수 있습니다. 컨트롤러는 이 컴퓨터에 남습니다."

msgid "Username"
msgstr "사용자 이름"

msgid "Password"
msgstr "암호"

msgid "Lets every account open its mixed port to the local network."
msgstr "각 계정이 혼합 포트를 로컬 네트워크에 열 수 있습니다."

msgid "Allow LAN for this account"
msgstr "이 계정의 로컬 네트워크 허용"

msgid "When this is off, this account's mixed port stays on this computer."
msgstr "끄면 이 계정의 혼합 포트는 이 컴퓨터에만 남습니다."

msgid "When this is off, that account's mixed port stays on this computer."
msgstr "끄면 그 계정의 혼합 포트는 이 컴퓨터에만 남습니다."

msgid "Adds a route to the current profile, which a subscription update replaces."
msgstr "현재 프로필에 경로를 추가합니다. 구독을 업데이트하면 파일 전체가 바뀝니다."

msgid "Removes the selected route from the current profile, which a subscription update replaces."
msgstr "현재 프로필에서 선택한 경로를 제거합니다. 구독을 업데이트하면 파일 전체가 바뀝니다."

msgid "Remove this route?"
msgstr "이 경로를 제거할까요?"

msgid "Add a route"
msgstr "경로 추가"

msgid "Show details"
msgstr "자세히 보기"

msgid "Hide details"
msgstr "자세히 숨기기"

msgid "Save"
msgstr "저장"

msgid "Server"
msgstr "서버"

msgid "Route"
msgstr "경로"

msgid "Current"
msgstr "현재"

msgid "Available"
msgstr "사용 가능"

msgid "Type"
msgstr "종류"

msgid "Port"
msgstr "포트"

msgid "Hold to show the password."
msgstr "누르고 있는 동안 비밀번호를 보여 줍니다."

msgid "Select a route to see its details."
msgstr "경로를 고르면 자세한 내용이 나옵니다."

msgid "Opens this profile in the editor. A subscription update replaces the whole file."
msgstr "이 프로필을 편집기에서 엽니다. 구독을 업데이트하면 파일 전체가 바뀝니다."

msgid "Appearance"
msgstr "모양"

msgid "Compact mode"
msgstr "간단히 보기"

msgid "Shows only the name in the profile list and the route list."
msgstr "프로필 목록과 경로 목록에는 이름만 표시합니다."

msgid "System proxy does nothing while traffic capture is on."
msgstr "트래픽 가로채기가 켜져 있으면 시스템 프록시는 동작하지 않습니다."

msgid "This computer's capture stays on until it is turned off from the Other page."
msgstr "이 컴퓨터의 가로채기는 기타 페이지에서 끄기 전까지 유지됩니다."

msgid "The name shown in the list. Renaming it updates the groups that use it."
msgstr "목록에 보이는 이름입니다. 바꾸면 이 이름을 쓰는 그룹도 함께 바뀝니다."

msgid "The protocol this route uses."
msgstr "이 경로가 사용하는 프로토콜입니다."

msgid "The server this route connects to."
msgstr "이 경로가 연결하는 서버입니다."

msgid "The server port."
msgstr "서버의 포트입니다."

msgid "The password for this route. For VMess this is the UUID."
msgstr "이 경로의 비밀번호입니다. VMess에서는 UUID입니다."
