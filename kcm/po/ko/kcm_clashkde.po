msgstr "사용 중"

msgid "Add subscription"
msgstr "구독 추가"

msgid "Advanced"
msgstr "고급"

msgid "Check region"
msgstr "지역 확인"

msgid "Controller port"
msgstr "컨트롤러 포트"

msgid "Core"
msgstr "코어"

msgid "Core is not running"
msgstr "코어가 실행 중이 아닙니다"

msgid "Core state"
msgstr "코어 상태"

