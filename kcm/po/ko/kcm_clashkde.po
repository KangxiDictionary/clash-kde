msgid "There is a Mihomo widget for the panel."
msgstr "패널용 Mihomo 위젯이 있습니다."

msgid "Other programs can use this address as it is."
msgstr "다른 프로그램도 이 주소를 그대로 쓸 수 있습니다."

msgid "This switch only starts the local proxy."
msgstr "이 스위치는 로컬 프록시만 켭니다."

msgid "This takes effect only while the core is running and TUN is off."
msgstr "코어가 실행 중이고 TUN이 꺼져 있을 때만 적용됩니다."

msgid "Restart the core with the configuration it already has."
msgstr "지금 설정 그대로 코어를 다시 시작합니다."

msgid "See which region the traffic is leaving from."
msgstr "트래픽이 지금 어느 지역으로 나가는지 봅니다."

msgid "HTTP and SOCKS share this port, and saving restarts a running core."
msgstr "HTTP와 SOCKS가 이 포트를 같이 쓰며, 저장하면 켜진 코어가 다시 시작됩니다."

msgid "This page talks to the controller, which listens only on this computer."
msgstr "이 페이지는 컨트롤러와 이야기하며, 컨트롤러는 이 컴퓨터에서만 듣습니다."

msgid "This is the mihomo program already installed on the system."
msgstr "시스템에 이미 설치되어 있는 mihomo입니다."

msgid "This file is placed over the subscription, while the listen address stays set here."
msgstr "이 파일이 구독 위에 덮이며, 수신 주소는 여전히 여기서 정합니다."

msgid "A subscription update replaces the text written here."
msgstr "구독을 업데이트하면 여기에 쓴 내용이 바뀝니다."

msgid "TUN"
msgstr "TUN"

msgid "This captures only this account's traffic, and the system proxy steps aside while it is on."
msgstr "이 계정의 트래픽만 잡고, 켜져 있는 동안에는 시스템 프록시가 비켜 줍니다."

msgid "Users"
msgstr "사용자"

msgid "This page starts and stops Mihomo for accounts that are signed in."
msgstr "이 페이지는 로그인한 계정 자신의 Mihomo를 켜고 끕니다."

msgid "Account"
msgstr "계정"

msgid "On"
msgstr "켜짐"

msgid "Off"
msgstr "꺼짐"

msgid "Start"
msgstr "시작"

msgid "Stop"
msgstr "중지"

msgid "Check"
msgstr "검사"

msgid "Open in editor"
msgstr "편집기로 열기"

msgid "This configuration can be read."
msgstr "이 구성을 읽을 수 있습니다."

msgid "No text editor was found."
msgstr "텍스트 편집기를 찾지 못했습니다."

msgid "View log"
msgstr "로그 보기"

msgid "Core log"
msgstr "코어 로그"

msgid "There is no log yet."
msgstr "아직 로그가 없습니다."

msgid "Start this account's core"
msgstr "이 계정의 코어 시작"

msgid "Stop this account's core"
msgstr "이 계정의 코어 중지"

msgid "The core is running."
msgstr "코어가 실행 중입니다."

msgid "The core is stopped."
msgstr "코어가 중지되어 있습니다."

msgid "Traffic capture"
msgstr "트래픽 가로채기"

msgid "This account"
msgstr "이 계정"

msgid "No signed-in accounts."
msgstr "로그인한 계정이 없습니다."

msgid "This page starts or stops the core of a signed-in account."
msgstr "이 페이지에서는 로그인한 계정의 코어를 시작하거나 중지합니다."

msgid "The firewall is on, and it can drop TUN traffic."
msgstr "방화벽이 켜져 있어 TUN 트래픽이 버려질 수 있습니다."
