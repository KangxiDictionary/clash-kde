msgid "There is a Mihomo widget for the panel."
msgstr "Для панели есть виджет Mihomo."

msgid "Other programs can use this address as it is."
msgstr "Другие программы могут использовать этот адрес как есть."

msgid "This switch only starts the local proxy."
msgstr "Этот переключатель только запускает локальный прокси."

msgid "KDE and browsers follow this only while the core is running."
msgstr "KDE и браузеры идут через это, только пока ядро запущено."

msgid "Restart the core with the configuration it already has."
msgstr "Перезапустить ядро с текущей конфигурацией."

msgid "See which region the traffic is leaving from."
msgstr "Посмотреть, из какого региона выходит трафик."

msgid "HTTP and SOCKS share this port, and saving restarts a running core."
msgstr "HTTP и SOCKS делят этот порт, а сохранение перезапускает работающее ядро."

msgid "This page talks to the controller, which listens only on this computer."
msgstr "Эта страница говорит с контроллером, а он слушает только на этом компьютере."

msgid "This is the mihomo program already installed on the system."
msgstr "Это уже установленная в системе программа mihomo."

msgid "This file is placed over the subscription, while the listen address stays set here."
msgstr "Этот файл ложится поверх подписки, а адрес прослушивания по-прежнему задаётся здесь."

msgid "A subscription update replaces the text written here."
msgstr "Обновление подписки заменяет текст, написанный здесь."

msgid "TUN"
msgstr "TUN"

msgid "This captures only this account's traffic, and the system proxy steps aside while it is on."
msgstr "Это перехватывает только трафик этой учётной записи, и пока оно включено, системный прокси уступает."

msgid "Users"
msgstr "Пользователи"

msgid "This page starts and stops Mihomo for accounts that are signed in."
msgstr "Эта страница запускает и останавливает Mihomo у вошедших учётных записей."

msgid "Account"
msgstr "Учётная запись"

msgid "On"
msgstr "Вкл"

msgid "Off"
msgstr "Выкл"

msgid "Start"
msgstr "Запустить"

msgid "Stop"
msgstr "Остановить"

msgid "Check"
msgstr "Проверить"

msgid "Open in editor"
msgstr "Открыть в редакторе"

msgid "This configuration can be read."
msgstr "Эту конфигурацию можно прочитать."

msgid "No text editor was found."
msgstr "Текстовый редактор не найден."

msgid "View log"
msgstr "Открыть журнал"

msgid "Core log"
msgstr "Журнал ядра"

msgid "There is no log yet."
msgstr "Журнала ещё нет."

msgid "Start this account's core"
msgstr "Запустить ядро этой учётной записи"

msgid "Stop this account's core"
msgstr "Остановить ядро этой учётной записи"

msgid "The core is running."
msgstr "Ядро работает."

msgid "The core is stopped."
msgstr "Ядро остановлено."

msgid "Traffic capture"
msgstr "Перехват трафика"

msgid "This account"
msgstr "Эта учётная запись"

msgid "No signed-in accounts."
msgstr "Нет вошедших учётных записей."

msgid "This page starts or stops the core of a signed-in account."
msgstr "Эта страница запускает или останавливает ядро вошедшей учётной записи."
